    "## 2. Load the Kermany dataset from Google Drive\n",
    "\n",
    "First put the dataset in your Drive, either as the Kaggle **ZIP** (e.g. `MyDrive/chest_xray.zip`) or as the extracted folder (e.g. `MyDrive/chest_xray/`). Then set `DRIVE_DATA` in the next cell to that path.\n",
    "\n",
    "- A **ZIP** is extracted to the fast local Colab disk.\n",
    "- A **folder** is copied to the local Colab disk (training straight from Drive is much slower). Set `COPY_TO_LOCAL = False` to read from Drive directly.\n",
    "\n",
    "Accepted layouts (nested folders such as `chest_xray/chest_xray/` and `__MACOSX` junk are handled automatically):\n",
    "\n",
    "```text\n",
    "chest_xray/                 chest_xray/\n",
    "\u251c\u2500\u2500 train/                  \u251c\u2500\u2500 NORMAL/        <- \"flat\" layout: no train/test folders;\n",
    "\u2502   \u251c\u2500\u2500 NORMAL/             \u2514\u2500\u2500 PNEUMONIA/        a stratified 70/15/15 split is created for you\n",
    "\u2502   \u2514\u2500\u2500 PNEUMONIA/\n",
    "\u251c\u2500\u2500 val/   (optional)\n",
    "\u2514\u2500\u2500 test/\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5241721b",
   "metadata": {},
   "outputs": [],
   "source": [
    "import zipfile, shutil\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "# EDIT THIS: a .zip file OR a folder in your Google Drive\n",
    "# Examples:  Path('/content/drive/MyDrive/chest_xray.zip')   Path('/content/drive/MyDrive/chest_xray')\n",
    "DRIVE_DATA = Path('/content/drive/MyDrive/chest_xray.zip')\n",
    "COPY_TO_LOCAL = True          # copy a Drive *folder* to local disk for faster training\n",
    "\n",
    "LOCAL_DIR = Path('/content/local_data')\n",
    "LOCAL_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def find_dataset_root(base):\n",
    "    \"\"\"Return (folder, layout). layout is 'split' (train/ + test/) or 'flat' (NORMAL/ + PNEUMONIA/).\"\"\"\n",
    "    dirs = [base] + [p for p in base.rglob('*') if p.is_dir() and '__MACOSX' not in p.parts]\n",
    "    for d in dirs:\n",
    "        if {'train', 'test'} <= {c.name.lower() for c in d.iterdir() if c.is_dir()}:\n",
    "            return d, 'split'\n",
    "    for d in dirs:\n",
    "        if {'NORMAL', 'PNEUMONIA'} <= {c.name.upper() for c in d.iterdir() if c.is_dir()}:\n",
    "            return d, 'flat'\n",
    "    return None, None\n",
    "\n",
    "if not DRIVE_DATA.exists():\n",
    "    raise FileNotFoundError(f\"{DRIVE_DATA} not found. Check the path (Drive appears under /content/drive/MyDrive/).\")\n",
    "\n",
    "if not any(LOCAL_DIR.iterdir()):                      # skip if a previous run already prepared the data\n",
    "    if DRIVE_DATA.is_file() and DRIVE_DATA.suffix.lower() == '.zip':\n",
    "        print(\"Extracting\", DRIVE_DATA.name, \"to local disk...\")\n",
    "        with zipfile.ZipFile(DRIVE_DATA) as z:\n",
    "            z.extractall(LOCAL_DIR)\n",
    "        search_base = LOCAL_DIR\n",
    "    elif DRIVE_DATA.is_dir() and COPY_TO_LOCAL:\n",
    "        print(\"Copying folder from Drive to local disk (this can take a few minutes)...\")\n",
    "        shutil.copytree(DRIVE_DATA, LOCAL_DIR / DRIVE_DATA.name, dirs_exist_ok=True)\n",
    "        search_base = LOCAL_DIR\n",
    "    elif DRIVE_DATA.is_dir():\n",
    "        search_base = DRIVE_DATA\n",
    "    else:\n",
    "        raise ValueError(\"DRIVE_DATA must be a .zip file or a folder.\")\n",
    "else:\n",
    "    print(\"Using data already prepared in\", LOCAL_DIR)\n",
    "    search_base = LOCAL_DIR\n",
    "\n",
    "DATA_ROOT, LAYOUT = find_dataset_root(search_base)\n",
    "if DATA_ROOT is None:\n",
    "    raise FileNotFoundError(\n",
    "        \"Could not find train/ + test/ folders or NORMAL/ + PNEUMONIA/ folders in the dataset. \"\n",
    "        \"Check the ZIP/folder contents.\"\n",
    "    )\n",
    "\n",
    "print(\"Dataset root:\", DATA_ROOT, \"| layout:\", LAYOUT)\n",
    "print(\"Top-level entries:\", sorted(p.name for p in DATA_ROOT.iterdir()))"
   ]
  },
