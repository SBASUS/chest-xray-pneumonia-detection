   "cell_type": "code",
   "execution_count": null,
   "id": "0ecea5db",
   "metadata": {},
   "outputs": [],
   "source": [
    "@torch.no_grad()\n",
    "def predict_loader(model, loader):\n",
    "    model.eval()\n",
    "    ys, probs, paths = [], [], []\n",
    "    for images, labels, batch_paths in loader:\n",
    "        images = images.to(DEVICE)\n",
    "        logits = model(images).squeeze(1)\n",
    "        batch_probs = torch.sigmoid(logits).cpu().numpy()\n",
    "        probs.extend(batch_probs.tolist())\n",
    "        ys.extend(labels.numpy().astype(int).tolist())\n",
    "        paths.extend(list(batch_paths))\n",
    "    return np.asarray(ys), np.asarray(probs), paths\n",
    "\n",
    "y_test, p_test, test_paths = predict_loader(model, test_loader)\n",
    "y_pred = (p_test >= 0.5).astype(int)\n",
    "\n",
    "cm = confusion_matrix(y_test, y_pred, labels=[0, 1])\n",
    "tn, fp, fn, tp = cm.ravel()\n",
    "\n",
    "test_results = {\n",
    "    'accuracy': accuracy_score(y_test, y_pred),\n",
    "    'precision': precision_score(y_test, y_pred, zero_division=0),\n",
    "    'sensitivity_recall': recall_score(y_test, y_pred, zero_division=0),\n",
    "    'specificity': tn / max(tn + fp, 1),\n",
    "    'f1_score': f1_score(y_test, y_pred, zero_division=0),\n",
    "    'auroc': roc_auc_score(y_test, p_test) if len(np.unique(y_test)) == 2 else np.nan,\n",
    "    'auprc': average_precision_score(y_test, p_test) if len(np.unique(y_test)) == 2 else np.nan\n",
    "}\n",
    "\n",
    "results_df = pd.DataFrame([test_results]).T.rename(columns={0: 'Test result'})\n",
    "display(results_df.round(4))\n",
    "\n",
    "print(\"\\nClassification report:\")\n",
    "print(classification_report(y_test, y_pred, target_names=['NORMAL', 'PNEUMONIA'], zero_division=0))\n",
    "\n",
    "print(\"Confusion matrix [[TN, FP], [FN, TP]]:\")\n",
    "print(cm)\n",
    "\n",
    "results_df.to_csv(OUTPUT_DIR / 'test_metrics.csv')\n",
    "with open(OUTPUT_DIR / 'test_metrics.json', 'w') as f:\n",
    "    json.dump({k: (None if np.isnan(v) else float(v)) for k, v in test_results.items()}, f, indent=2)"
