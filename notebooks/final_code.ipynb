   "source": [
    "## 4. Create train, validation and test sets\n",
    "\n",
    "- If the supplied `val/` split has at least 100 images and both classes (or you used the flat layout, where val/ was created for you), it is used as validation.\n",
    "- If `val/` is missing or unusually tiny (as in some Kermany copies), a stratified validation split is drawn from `train/`.\n",
    "- The supplied `test/` split is never used for training or model selection.\n",
    "- This dataset does not provide reliable patient IDs in the folder structure. The split is therefore image-level, not guaranteed patient-level. State this limitation in any report."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "003bf675",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_all = manifest[manifest.split == 'train'].copy()\n",
    "test_df = manifest[manifest.split == 'test'].copy()\n",
    "val_existing = manifest[manifest.split == 'val'].copy()\n",
    "\n",
    "if train_all.empty or test_df.empty:\n",
    "    raise ValueError(\"Both train/ and test/ folders must contain images from NORMAL and PNEUMONIA.\")\n",
    "\n",
    "if set(train_all.label.unique()) != {0, 1} or set(test_df.label.unique()) != {0, 1}:\n",
    "    raise ValueError(\"Train and test must each contain both NORMAL and PNEUMONIA classes.\")\n",
    "\n",
    "if (LAYOUT == 'flat' or len(val_existing) >= 100) and set(val_existing.label.unique()) == {0, 1}:\n",
    "    train_df = train_all.copy()\n",
    "    val_df = val_existing.copy()\n",
    "    validation_source = \"provided val/ folder\"\n",
    "else:\n",
    "    train_df, val_df = train_test_split(\n",
    "        train_all,\n",
    "        test_size=0.15,\n",
    "        random_state=SEED,\n",
    "        stratify=train_all['label']\n",
    "    )\n",
    "    validation_source = \"15% stratified split from train/ (provided val/ was absent or too small)\"\n",
    "\n",
    "train_df = train_df.reset_index(drop=True)\n",
    "val_df = val_df.reset_index(drop=True)\n",
    "test_df = test_df.reset_index(drop=True)\n",
    "\n",
    "print(\"Validation source:\", validation_source)\n",
    "for name, frame in [('Train', train_df), ('Validation', val_df), ('Test', test_df)]:\n",
    "    print(f\"{name}: {len(frame)} images | counts: {frame.label.value_counts().sort_index().to_dict()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cf93b712",
   "metadata": {},
   "source": [
    "## 5. Image preprocessing and DataLoaders\n",
    "\n",
    "Images are resized to 224\u00d7224 and normalized using ImageNet statistics because DenseNet121 is initialized with ImageNet pretrained weights. Mild augmentation is applied to training images only."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "99a794d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "IMG_SIZE = 224\n",
    "BATCH_SIZE = 32 if DEVICE.type == 'cuda' else 8\n",
    "NUM_WORKERS = 2\n",
    "\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.RandomRotation(degrees=7),\n",
    "    transforms.RandomHorizontalFlip(p=0.5),\n",
    "    transforms.ColorJitter(brightness=0.08, contrast=0.08),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
    "                         std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "eval_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
    "                         std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "class ChestXrayDataset(Dataset):\n",
    "    def __init__(self, frame, transform=None):\n",
    "        self.frame = frame.reset_index(drop=True)\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.frame)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.frame.iloc[idx]\n",
    "        image = Image.open(row.image_path).convert('RGB')\n",
    "        if self.transform:\n",
    "            image = self.transform(image)\n",
    "        label = torch.tensor(float(row.label), dtype=torch.float32)\n",
    "        return image, label, row.image_path\n",
    "\n",
    "train_ds = ChestXrayDataset(train_df, train_transform)\n",
    "val_ds = ChestXrayDataset(val_df, eval_transform)\n",
    "test_ds = ChestXrayDataset(test_df, eval_transform)\n",
    "\n",
    "train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True,\n",
    "                          num_workers=NUM_WORKERS, pin_memory=(DEVICE.type == 'cuda'))\n",
    "val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False,\n",
    "                        num_workers=NUM_WORKERS, pin_memory=(DEVICE.type == 'cuda'))\n",
    "test_loader = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False,\n",
    "                         num_workers=NUM_WORKERS, pin_memory=(DEVICE.type == 'cuda'))\n",
    "\n",
    "print(\"Loaders ready.\")\n",
    "print(\"Batches \u2014 train:\", len(train_loader), \"validation:\", len(val_loader), \"test:\", len(test_loader))"
   ]
  },
  {
