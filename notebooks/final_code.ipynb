   "metadata": {},
   "source": [
    "## 8. Train the model\n",
    "\n",
    "Start with up to 10 epochs. Early stopping will stop training if validation AUROC does not improve for 4 epochs. On a T4 GPU, runtime depends on dataset size and Colab availability. If the session disconnects, rerun setup and load the saved checkpoint if available."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5ac954ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "EPOCHS = 10\n",
    "PATIENCE = 4\n",
    "best_auc = -np.inf\n",
    "best_val_loss = np.inf\n",
    "epochs_without_improvement = 0\n",
    "history = []\n",
    "\n",
    "OUTPUT_DIR = Path('/content/pneumonia_project_outputs')\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "BEST_MODEL_PATH = OUTPUT_DIR / 'best_densenet121_pneumonia.pth'\n",
    "\n",
    "start_time = time.time()\n",
    "\n",
    "for epoch in range(1, EPOCHS + 1):\n",
    "    train_metrics, _, _ = run_one_epoch(model, train_loader, training=True)\n",
    "    val_metrics, _, _ = run_one_epoch(model, val_loader, training=False)\n",
    "\n",
    "    current_auc = val_metrics['auroc']\n",
    "    score = current_auc if not np.isnan(current_auc) else -val_metrics['loss']\n",
    "    scheduler.step(score)\n",
    "\n",
    "    row = {'epoch': epoch}\n",
    "    row.update({f'train_{k}': v for k, v in train_metrics.items()})\n",
    "    row.update({f'val_{k}': v for k, v in val_metrics.items()})\n",
    "    history.append(row)\n",
    "\n",
    "    print(\n",
    "        f\"Epoch {epoch:02d}/{EPOCHS} | \"\n",
    "        f\"train loss {train_metrics['loss']:.4f} | \"\n",
    "        f\"val loss {val_metrics['loss']:.4f} | \"\n",
    "        f\"val AUROC {val_metrics['auroc']:.4f} | \"\n",
    "        f\"val F1 {val_metrics['f1']:.4f}\"\n",
    "    )\n",
    "\n",
    "    improved = (current_auc > best_auc) if not np.isnan(current_auc) else (val_metrics['loss'] < best_val_loss)\n",
    "    if improved:\n",
    "        best_auc = current_auc if not np.isnan(current_auc) else best_auc\n",
    "        best_val_loss = min(best_val_loss, val_metrics['loss'])\n",
    "        torch.save(model.state_dict(), BEST_MODEL_PATH)\n",
    "        epochs_without_improvement = 0\n",
    "        print(\"  Saved new best checkpoint.\")\n",
    "    else:\n",
    "        epochs_without_improvement += 1\n",
    "\n",
    "    if epochs_without_improvement >= PATIENCE:\n",
    "        print(\"Early stopping triggered.\")\n",
    "        break\n",
    "\n",
    "print(f\"Training time: {(time.time() - start_time)/60:.1f} minutes\")\n",
    "print(\"Best checkpoint:\", BEST_MODEL_PATH)\n",
    "\n",
    "history_df = pd.DataFrame(history)\n",
    "display(history_df.round(4))\n",
    "history_df.to_csv(OUTPUT_DIR / 'training_history.csv', index=False)\n",
    "\n",
    "model.load_state_dict(torch.load(BEST_MODEL_PATH, map_location=DEVICE))"
   ]
  },
