   "source": [
    "## 6. Build DenseNet121\n",
    "\n",
    "We use transfer learning with ImageNet pretrained DenseNet121. The classifier head is replaced with a single logit for binary classification. The final dense block and classifier are trainable; earlier feature layers are initially frozen to reduce training time and overfitting."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3b6f5d68",
   "metadata": {},
   "outputs": [],
   "source": [
    "from torchvision.models import DenseNet121_Weights\n",
    "\n",
    "weights = DenseNet121_Weights.DEFAULT\n",
    "model = models.densenet121(weights=weights)\n",
    "\n",
    "# Freeze the feature extractor first\n",
    "for param in model.features.parameters():\n",
    "    param.requires_grad = False\n",
    "\n",
    "# Unfreeze the final dense block and final normalization\n",
    "for name, param in model.features.named_parameters():\n",
    "    if name.startswith('denseblock4') or name.startswith('norm5'):\n",
    "        param.requires_grad = True\n",
    "\n",
    "in_features = model.classifier.in_features\n",
    "model.classifier = nn.Sequential(\n",
    "    nn.Dropout(p=0.35),\n",
    "    nn.Linear(in_features, 1)\n",
    ")\n",
    "model = model.to(DEVICE)\n",
    "\n",
    "trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "total = sum(p.numel() for p in model.parameters())\n",
    "print(f\"Trainable parameters: {trainable:,} / {total:,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6380ce27",
   "metadata": {},
   "source": [
    "## 7. Loss, optimizer and training functions\n",
    "\n",
    "The positive-class weight is computed from the training split to account for class imbalance. We select the best checkpoint using validation AUROC (with validation loss as a fallback if AUROC cannot be calculated)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a56bc4e7",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_counts = train_df.label.value_counts().to_dict()\n",
    "neg_count = train_counts.get(0, 0)\n",
    "pos_count = train_counts.get(1, 0)\n",
    "pos_weight = torch.tensor([neg_count / max(pos_count, 1)], dtype=torch.float32, device=DEVICE)\n",
    "\n",
    "criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n",
    "optimizer = torch.optim.AdamW(\n",
    "    [p for p in model.parameters() if p.requires_grad],\n",
    "    lr=1e-4,\n",
    "    weight_decay=1e-4\n",
    ")\n",
    "scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "    optimizer, mode='max', factor=0.5, patience=2\n",
    ")\n",
    "\n",
    "def run_one_epoch(model, loader, training=False):\n",
    "    model.train(training)\n",
    "    running_loss = 0.0\n",
    "    all_labels, all_probs = [], []\n",
    "\n",
    "    for images, labels, _ in loader:\n",
    "        images = images.to(DEVICE, non_blocking=True)\n",
    "        labels = labels.to(DEVICE, non_blocking=True)\n",
    "\n",
    "        if training:\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "\n",
    "        with torch.set_grad_enabled(training):\n",
    "            logits = model(images).squeeze(1)\n",
    "            loss = criterion(logits, labels)\n",
    "            if training:\n",
    "                loss.backward()\n",
    "                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n",
    "                optimizer.step()\n",
    "\n",
    "        probs = torch.sigmoid(logits)\n",
    "        running_loss += loss.item() * images.size(0)\n",
    "        all_labels.extend(labels.detach().cpu().numpy().astype(int).tolist())\n",
    "        all_probs.extend(probs.detach().cpu().numpy().tolist())\n",
    "\n",
    "    avg_loss = running_loss / max(1, len(loader.dataset))\n",
    "    y_true = np.asarray(all_labels)\n",
    "    y_prob = np.asarray(all_probs)\n",
    "    y_pred = (y_prob >= 0.5).astype(int)\n",
    "\n",
    "    auc = roc_auc_score(y_true, y_prob) if len(np.unique(y_true)) == 2 else np.nan\n",
    "    metrics = {\n",
    "        'loss': avg_loss,\n",
    "        'accuracy': accuracy_score(y_true, y_pred),\n",
    "        'precision': precision_score(y_true, y_pred, zero_division=0),\n",
    "        'recall': recall_score(y_true, y_pred, zero_division=0),\n",
    "        'f1': f1_score(y_true, y_pred, zero_division=0),\n",
    "        'auroc': auc\n",
    "    }\n",
    "    return metrics, y_true, y_prob\n",
    "\n",
    "print(\"Training functions ready.\")"
   ]
  },
