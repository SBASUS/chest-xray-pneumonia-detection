    "## 13. Reusable single-image prediction function (dataset image or an image in your Drive)\n",
    "\n",
    "Use `predict_xray(path)` for any image file, or `predict_from_drive(path)` for a single image or a whole folder of images in your Drive. Predictions are model outputs, not medical diagnoses."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a79b67bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "@torch.no_grad()\n",
    "def predict_xray(image_path, threshold=0.5):\n",
    "    model.eval()\n",
    "    image = Image.open(image_path).convert('RGB')\n",
    "    x = eval_transform(image).unsqueeze(0).to(DEVICE)\n",
    "    probability = torch.sigmoid(model(x).squeeze()).item()\n",
    "    predicted = 'PNEUMONIA' if probability >= threshold else 'NORMAL'\n",
    "\n",
    "    plt.figure(figsize=(5, 5))\n",
    "    plt.imshow(image, cmap='gray')\n",
    "    plt.title(f\"Model output: {predicted}\\nP(pneumonia) = {probability:.3f}\")\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "    return {'predicted_class': predicted, 'p_pneumonia': probability}\n",
    "\n",
    "# Example:\n",
    "predict_xray(test_paths[0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "75ca6165",
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_from_drive(path, threshold=0.5):\n",
    "    \"\"\"Run the trained model on one image, or on every image in a Drive folder.\"\"\"\n",
    "    path = Path(path)\n",
    "    imgs = [path] if path.is_file() else sorted(p for p in path.rglob('*')\n",
    "                                               if p.is_file() and not p.name.startswith('.')\n",
    "                                               and p.suffix.lower() in IMAGE_EXTS)\n",
    "    if not imgs:\n",
    "        raise FileNotFoundError(f\"No images found at {path}\")\n",
    "    results = {}\n",
    "    for p in imgs[:20]:                       # cap plots at 20 images per call\n",
    "        try:\n",
    "            results[p.name] = predict_xray(p, threshold=threshold)\n",
    "        except Exception as e:\n",
    "            print(f\"Could not read {p.name}: {e}\")\n",
    "    return results\n",
    "\n",
    "# Example (edit the path):\n",
    "# predict_from_drive('/content/drive/MyDrive/my_xrays/example.jpeg')"
   ]
  },
