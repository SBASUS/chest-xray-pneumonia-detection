   "source": [
    "## 3. Discover images and verify class labels\n",
    "\n",
    "This cell supports the common Kermany folder names `NORMAL` and `PNEUMONIA` (case-insensitive). It checks that image files exist and builds a manifest. For the `split` layout the official `test/` directory is kept untouched for final evaluation; for the `flat` layout a stratified 70/15/15 train/val/test split is created."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0cc19485",
   "metadata": {},
   "outputs": [],
   "source": [
    "IMAGE_EXTS = {'.jpg', '.jpeg', '.png', '.bmp', '.tif', '.tiff', '.webp'}\n",
    "CLASS_TO_LABEL = {'NORMAL': 0, 'PNEUMONIA': 1}\n",
    "SPLIT_ALIASES = {'train': 'train', 'val': 'val', 'valid': 'val', 'validation': 'val', 'test': 'test'}\n",
    "\n",
    "def collect_dir(folder, split_name):\n",
    "    rows = []\n",
    "    for class_dir in folder.iterdir():\n",
    "        cname = class_dir.name.upper()\n",
    "        if class_dir.is_dir() and cname in CLASS_TO_LABEL:\n",
    "            for p in class_dir.rglob('*'):\n",
    "                if p.is_file() and not p.name.startswith('.') and p.suffix.lower() in IMAGE_EXTS:\n",
    "                    rows.append({'image_path': str(p), 'split': split_name,\n",
    "                                 'class_name': cname, 'label': CLASS_TO_LABEL[cname]})\n",
    "    return rows\n",
    "\n",
    "all_rows = []\n",
    "if LAYOUT == 'split':\n",
    "    for d in DATA_ROOT.iterdir():\n",
    "        if d.is_dir() and d.name.lower() in SPLIT_ALIASES:\n",
    "            all_rows.extend(collect_dir(d, SPLIT_ALIASES[d.name.lower()]))\n",
    "else:  # flat layout -> create a stratified split\n",
    "    all_rows = collect_dir(DATA_ROOT, 'all')\n",
    "\n",
    "manifest = pd.DataFrame(all_rows)\n",
    "if manifest.empty:\n",
    "    raise FileNotFoundError(f\"No images found under {DATA_ROOT}.\")\n",
    "\n",
    "if LAYOUT == 'flat':\n",
    "    idx_trainval, idx_test = train_test_split(manifest.index, test_size=0.15, random_state=SEED,\n",
    "                                              stratify=manifest['label'])\n",
    "    idx_train, idx_val = train_test_split(idx_trainval, test_size=0.15 / 0.85, random_state=SEED,\n",
    "                                          stratify=manifest.loc[idx_trainval, 'label'])\n",
    "    manifest.loc[idx_train, 'split'] = 'train'\n",
    "    manifest.loc[idx_val, 'split'] = 'val'\n",
    "    manifest.loc[idx_test, 'split'] = 'test'\n",
    "\n",
    "print(\"Total images:\", len(manifest))\n",
    "display(pd.crosstab(manifest['split'], manifest['class_name'], margins=True))\n",
    "print(\"\\nClass mapping:\", CLASS_TO_LABEL)\n",
    "print(\"\\nExample paths:\")\n",
    "display(manifest.head())"
   ]
  },
